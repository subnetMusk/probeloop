# Normalize line endings: files are mounted into Linux containers.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.wav binary
*.flac binary
*.ogg binary
*.mp3 binary
*.onnx binary
*.woff binary
*.woff2 binary
