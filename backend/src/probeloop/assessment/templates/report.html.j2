<!doctype html>
<html lang="{{ report.language }}">
<meta charset="utf-8">
<title>ProbeLoop - {{ outline.title }}</title>
<style>
@page { size: A4; margin: 18mm; @bottom-right { content: counter(page) ' / ' counter(pages); font-size: 9pt; color: #666; } }
body { font: 9.5pt/1.45 'DejaVu Sans', sans-serif; color: #171717; }
h1 { font-size: 24pt; margin: 0 0 2mm; } h1 span { color: #7c3aed; }
h2 { font-size: 16pt; margin: 7mm 0 3mm; break-after: avoid; }
h3 { font-size: 11pt; margin: 4mm 0 2mm; break-after: avoid; }
p, blockquote { white-space: pre-wrap; overflow-wrap: anywhere; margin: 2mm 0; }
blockquote { border-left: 2pt solid #7c3aed; padding-left: 3mm; color: #555; }
.hero { border: 1pt solid #ddd; border-top: 3pt solid #7c3aed; border-radius: 3mm; padding: 5mm; }
.rating { font-size: 27pt; font-weight: bold; } .muted { color: #555; font-size: 8.5pt; }
.entry { padding-bottom: 2mm; border-bottom: .5pt solid #ddd; }
.correction { border-left: 2pt solid #ea580c; padding: 2mm 3mm; background: #f5f5f5; }
.technical { font-size: 8pt; } .appendix { margin-top: 8mm; }
table { width: 100%; border-collapse: collapse; font-size: 8.5pt; }
thead { display: table-header-group; } th, td { text-align: left; vertical-align: top; padding: 2mm; border-bottom: .5pt solid #ddd; overflow-wrap: anywhere; }
tr, blockquote { break-inside: avoid; }
</style>
{% macro quotes(items) %}{% for quote in items %}<blockquote>{{ quote.text }}{% if quote.answer is not none %}<br><span class="muted">{{ label('Answer') }} {{ quote.answer }}</span>{% endif %}</blockquote>{% endfor %}{% endmacro %}
{% macro notes(items) %}{% for note in items %}<div class="entry">{% if note.unit is not none %}<h3>{{ label('Question') }} {{ note.unit }}</h3>{% endif %}<p>{{ note.text }}</p>{{ quotes(note.quotes) }}{% if note.replacement %}<div class="correction"><strong>{{ label('Suggested correction') }}</strong><p>{{ note.replacement }}</p></div>{% endif %}</div>{% else %}<p class="muted">{{ label('No evidence-backed observations.') }}</p>{% endfor %}{% endmacro %}
{% macro criteria(items) %}{% for item in items %}<div class="entry"><h3>{{ item.label }}: {{ rating(item.value) if item.value is not none else label('Not assessable') }} / 100{% if item.unstable %} *{% endif %}</h3><p>{{ item.reason }}</p>{{ quotes(item.quotes) }}</div>{% endfor %}{% endmacro %}
<h1>Probe<span>Loop</span></h1><p>{{ outline.title }} - v{{ report.version }}</p>
{% for section in outline.sections %}
<section id="{{ section }}"><h2>{{ heading(section) }}</h2>
{% if section == 'overview' %}<div class="hero"><p class="rating">{{ rating(outline.overall) if outline.overall is not none else label('Not assessable') }} / 100</p><p>{{ label(outline.band) if outline.band else '' }} · {{ outline.assessed }}/{{ outline.criteria_count }}</p>{% if outline.summary %}{{ notes([outline.summary]) }}{% endif %}{% if outline.target %}<h3>{{ label('Confirmed target') }}</h3><p>{{ outline.target }}</p><p class='muted'>{{ report.disclaimer }}</p>{% endif %}{% if outline.references %}<h3>{{ label('Provided references') }}</h3>{% for title in outline.references %}<p>{{ title }}</p>{% endfor %}{% endif %}</div>
{% elif section in ['improvements', 'strengths', 'rewrites', 'practice'] %}{{ notes(outline[section]) }}
{% elif section == 'criteria' %}{{ criteria(outline.criteria) }}
{% elif section == 'questions' %}{% for unit in outline.units %}<h3>{{ label('Question') }} {{ unit.number }}</h3>{% for question in unit.questions %}<p>{{ question }}</p>{% endfor %}{% for answer in unit.answers %}<h3>{{ label('Answer') }} {{ answer.number }}</h3><p>{{ answer.text }}</p>{% endfor %}{% if unit.scored %}{{ criteria(unit.scores) }}{% else %}<p class="muted">{{ label(unit.kind) }} · {{ label('Not scored') }}</p>{% endif %}{% if unit.assistance %}<h3>{{ label('Assistance during this exchange') }}</h3>{% for help in unit.assistance %}<p><strong>{{ label(help.purpose) }} {{ help.level or '' }}</strong>: {{ help.text }}</p>{% endfor %}{% endif %}{% endfor %}<h3>{{ label('Assessment criteria') }}</h3>{{ criteria(outline.criteria) }}
{% elif section == 'requirements' %}<table><thead><tr><th>{{ heading('requirements') }}</th><th>{{ label('In the interview') }}</th><th>{{ label('In your documents') }}</th></tr></thead><tbody>{% for row in outline.requirements %}<tr><td>{{ row.text }}{{ quotes(row.quotes) }}</td><td>{{ label(row.interview) if row.interview else '—' }}</td><td>{{ label(row.documents) if row.documents else '—' }}</td></tr>{% endfor %}</tbody></table>
{% elif section == 'checks' %}{% for check in outline.checks %}<p><strong>{{ label(check.status) }}</strong>: {{ check.detail }}</p>{{ quotes(check.quotes) }}{% endfor %}
{% elif section == 'delivery' and outline.delivery %}{% set d = outline.delivery %}<table><tbody>{% for name, value, unit in [('Median pace', d.median_rate, label('Words/min')), ('Median response latency', d.median_latency, 's'), ('Fillers per minute', d.fillers_per_minute, ''), ('Long pauses', d.long_pauses, ''), ('Talk share', d.talk_share, '%'), ('Answer budget used', d.budget_share, '%')] %}<tr><th>{{ label(name) }}</th><td>{{ value if value is not none else label('Not assessable') }}{% if value is not none %} {{ unit }}{% endif %}</td></tr>{% endfor %}</tbody></table>
{% elif section == 'original' %}<p>{{ outline.original or label('Typed text: there is no original file.') }}</p>
{% elif section == 'technical' %}{% set a = outline.technical %}<div class="technical">{% for name, value in [('Model', a.model), ('Prompt', a.prompt), ('Rubric', a.rubric ~ ' · ' ~ a.rubric_hash), ('Input hash', a.fingerprint), ('Discarded model items', a.dropped), ('Edited answers assessed', a.edited_answers), ('Processing time', a.duration_s ~ ' s')] %}<p><strong>{{ label(name) }}</strong>: {{ value }}</p>{% endfor %}{% if outline.unstable %}<p>* {{ label('Judgements differ by at least two points.') }}</p>{% endif %}<p>{{ a.disclaimer }}</p></div>
{% endif %}</section>{% endfor %}
{% if outline.delivery %}<section class="appendix"><h2>{{ label('Measures for each answer') }}</h2><table><thead><tr>{% for name in ['Answer', 'Duration (s)', 'Words/min', 'Fillers', 'Long pauses', 'Latency (s)'] %}<th>{{ label(name) }}</th>{% endfor %}</tr></thead><tbody>{% for row in outline.delivery.per_answer %}<tr><td>{{ row.answer }}</td>{% for value in [row.duration, row.rate, row.fillers, row.pauses, row.latency] %}<td>{{ value if value is not none else '—' }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></section>{% endif %}
</html>
